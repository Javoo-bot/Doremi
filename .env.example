# Copy to .env (Claude Code, scripts) and .dev.vars (wrangler dev). Both are gitignored.
# Never put real values in this file: the repo is public.

# LLM: lyrics transcription + coaching text
LLM_API_KEY=

# Langfuse: traces, latency, cost (https://cloud.langfuse.com or self-hosted)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# MCP servers used by Claude Code (.mcp.json reads these)
GITHUB_MCP_TOKEN=
LANGFUSE_MCP_TOKEN=
