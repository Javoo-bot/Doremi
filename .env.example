# Copy to .env (Claude Code, scripts) and .dev.vars (wrangler dev). Both are gitignored.
# Never put real values in this file: the repo is public.

# LLM via OpenRouter: lyrics transcription + coaching text. The fallback key is used on 401, 402 or 429.
OPENROUTER_API_KEY=
FALLBACK_OPEN_ROUTER=

# Langfuse: traces, latency, cost (EU https://cloud.langfuse.com, US https://us.cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# MCP servers used by Claude Code (.mcp.json reads these)
GITHUB_MCP_TOKEN=
LANGFUSE_MCP_TOKEN=
